# Exemplo — NÃO contém credenciais reais.
# Aplique secrets com:  ../FCG.Infra/scripts/apply-secrets.ps1
apiVersion: v1
kind: Secret
metadata:
  name: fcg-catalog-api-secret
type: Opaque
stringData:
  ConnectionStrings__DefaultConnection: "Host=fcg-postgres;Port=5432;Database=fcg_catalog;Username=<USER>;Password=<PASSWORD>"
  ConnectionStrings__MongoDB: "mongodb://fcg-mongodb:27017"
  ConnectionStrings__Redis: "fcg-redis:6379"
  ConnectionStrings__OpenSearch: "http://fcg-opensearch:9200"
  MessageBusConfigs__Host: "amqp://<USER>:<PASSWORD>@fcg-rabbitmq:5672/"
  Jwt__Key: "<JWT_KEY_MIN_32_CHARS>"
